  "markers": [
    {
      "id": "s1-c1",
      "text": "看起来白色的太阳光，包含多种颜色的光。",
      "keyword": "看起",
      "action": "track",
      "target": "e0",
      "start": 0,
      "end": 3.7333333333333334,
      "sceneId": "s1"
    },
    {
      "id": "s1-c2",
      "text": "红光、绿光、蓝光，都在这束光里。",
      "keyword": "红光",
      "action": "track",
      "target": "e1",
      "start": 3.7333333333333334,
      "end": 6.866666666666666,
      "sceneId": "s1"
    },
    {
      "id": "s1-c3",
      "text": "图里把颜色分开，只是为了看清组成。",
      "keyword": "图里",
      "action": "track",
      "target": "e2",
      "start": 6.866666666666666,
      "end": 10.2,
      "sceneId": "s1"
    },
    {
      "id": "s1-c4",
      "text": "空气对不同颜色的影响，是蓝天的关键。",
      "keyword": "空气",
      "action": "track",
      "target": "e2",
      "start": 10.2,
      "end": 13.733333333333333,
      "sceneId": "s1"
    },
    {
      "id": "s2-c1",
      "text": "看见一种颜色，意味着有相应的光进入眼睛。",
      "keyword": "看见",
      "action": "track",
      "target": "e0",
      "start": 13.733333333333333,
      "end": 17.666666666666668,
      "sceneId": "s2"
    },
    {
      "id": "s2-c2",
      "text": "我们抬头看天空，并不是一直盯着太阳。",
      "keyword": "我们",
      "action": "track",
      "target": "e1",
      "start": 17.666666666666668,
      "end": 21.2,
      "sceneId": "s2"
    },
    {
      "id": "s2-c3",
      "text": "那么，侧面天空的光是怎么到眼前的？",
      "keyword": "那么",
      "action": "track",
      "target": "e2",
      "start": 21.2,
      "end": 24.533333333333335,
      "sceneId": "s2"
    },
    {
      "id": "s2-c4",
      "text": "需要看看阳光经过空气时发生了什么。",
