  "captions": [
    {
      "id": "s1-c1",
      "text": "月相，就是从地球看见的月亮亮面形状。",
      "keyword": "亮面",
      "action": "morph",
      "target": "moon",
      "start": 0,
      "end": 4.466666666666667,
      "sceneId": "s1"
    },
    {
      "id": "s1-c2",
      "text": "月亮没有被咬掉；它反射太阳光。",
      "keyword": "月亮",
      "action": "morph",
      "target": "view",
      "start": 4.466666666666667,
      "end": 8.2,
      "sceneId": "s1"
    },
    {
      "id": "s2-c1",
      "text": "通常，太阳照亮月球的一半。",
      "keyword": "月球",
      "action": "morph",
      "target": "moon",
      "start": 8.2,
      "end": 11.433333333333334,
      "sceneId": "s2"
    },
    {
      "id": "s2-c2",
      "text": "另一半背着太阳，不是被地球挡住。",
      "keyword": "地球",
      "action": "morph",
      "target": "view",
      "start": 11.433333333333334,
      "end": 15.4,
      "sceneId": "s2"
    },
    {
      "id": "s3-c1",
      "text": "月球绕地球运动，我们看亮面的角度在变。",
      "keyword": "亮面",
      "action": "morph",
      "target": "moon",
      "start": 15.4,
      "end": 20.133333333333333,
      "sceneId": "s3"
    },
    {
      "id": "s3-c2",
      "text": "看见的亮面多，就更圆；看见得少，就更弯。",
      "keyword": "亮面",
      "action": "morph",
      "target": "view",
      "start": 20.133333333333333,
      "end": 25.1,
      "sceneId": "s3"
    },
    {
      "id": "s4-c1",
      "text": "地球的影子遮到月亮，才是月食。",
      "keyword": "地球",
      "action": "morph",
      "target": "moon",
      "start": 25.1,
      "end": 28.833333333333332,
      "sceneId": "s4"
    },
    {
      "id": "s4-c2",
      "text": "日常的圆缺变化，不需要地球挡光。",
      "keyword": "地球",
      "action": "morph",
      "target": "view",
      "start": 28.833333333333332,
      "end": 32.8,
      "sceneId": "s4"
    },
    {
      "id": "s5-c1",
      "text": "月球一直是球，变化的是我们看见的亮面。",
      "keyword": "亮面",
      "action": "morph",
      "target": "moon",
      "start": 32.8,
      "end": 37.53333333333333,
      "sceneId": "s5"
    },
    {
      "id": "s5-c2",
      "text": "记住：月相看角度，月食才是地球遮光。",
      "keyword": "地球",
      "action": "morph",
      "target": "view",
      "start": 37.53333333333333,
      "end": 42,
      "sceneId": "s5"
    }
  ]
