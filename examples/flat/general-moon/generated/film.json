    "claims": [
      {
        "id": "s1",
        "text": "月相，就是从地球看见的月亮亮面形状。月亮没有被咬掉；它反射太阳光。",
        "kind": "fact",
        "source_ids": [
          "nasa"
        ]
      },
      {
        "id": "s2",
        "text": "通常，太阳照亮月球的一半。另一半背着太阳，不是被地球挡住。",
        "kind": "fact",
        "source_ids": [
          "nasa"
        ]
      },
      {
        "id": "s3",
        "text": "月球绕地球运动，我们看亮面的角度在变。看见的亮面多，就更圆；看见得少，就更弯。",
        "kind": "fact",
        "source_ids": [
          "nasa"
        ]
      },
      {
        "id": "s4",
        "text": "地球的影子遮到月亮，才是月食。日常的圆缺变化，不需要地球挡光。",
        "kind": "fact",
        "source_ids": [
          "nasa",
          "eclipse"
        ]
      },
      {
        "id": "s5",
        "text": "月球一直是球，变化的是我们看见的亮面。记住：月相看角度，月食才是地球遮光。",
        "kind": "fact",
        "source_ids": [
          "nasa",
          "eclipse"
        ]
      }
    ],
